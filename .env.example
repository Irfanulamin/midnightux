# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# so never put a real secret here.
#
# Full walkthrough: docs/BOOKING-SETUP.md

# ---------------------------------------------------------------------------
# Cal.com — availability, the booking UI and the Google Meet link
# ---------------------------------------------------------------------------

# Your public Cal link, as `username/event-type`. This is the part of your
# cal.com URL after the domain. NEXT_PUBLIC_ because the embed runs in the
# browser; it is a public link, so there is nothing secret about it.
NEXT_PUBLIC_CAL_LINK=your-username/30min

# Optional. Comma-separated addresses copied onto every calendar invite.
# Prefer adding these to the event type in the Cal dashboard instead: anything
# with NEXT_PUBLIC_ is compiled into the JS bundle and can be scraped.
NEXT_PUBLIC_CAL_GUESTS=

# The secret you type into the Cal.com webhook form. Any long random string;
# generate one with:  openssl rand -hex 32
# Without it the webhook route rejects every request, so no emails are sent.
CAL_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Outgoing mail — the branded confirmation on top of Google's invite
# ---------------------------------------------------------------------------

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
# A Gmail APP PASSWORD (16 characters), not your account password.
# https://myaccount.google.com/apppasswords
SMTP_PASS=
MAIL_FROM=Midnight Surface <you@gmail.com>

# ---------------------------------------------------------------------------
# Who hears about a booking
# ---------------------------------------------------------------------------

# Two variables rather than one list, because a typo in a list silently drops
# a recipient. Both get the lead email.
OWNER_EMAIL=you@gmail.com
CEO_EMAIL=ceo@yourcompany.com

# IANA zone the lead email renders "When" in. The visitor's own zone is used
# for their copy regardless of this.
OWNER_TIMEZONE=UTC
